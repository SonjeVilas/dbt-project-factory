# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ──────────────────────────────────────────────
.env
.env.local
.env.production

# ── Generated output ───────────────────────────────────────────────────
generated_projects/*
!generated_projects/.gitkeep
!generated_projects/retail_dbt_v1/
# Never commit profiles with real credentials
generated_projects/retail_dbt_v1/profiles.yml
generated_projects/retail_dbt_v1/logs/
generated_projects/retail_dbt_v1/target/
generated_projects/retail_dbt_v1/.user.yml
!generated_projects/retail_analytics_v2/
generated_projects/retail_analytics_v2/profiles.yml
generated_projects/retail_analytics_v2/logs/
generated_projects/retail_analytics_v2/target/
generated_projects/retail_analytics_v2/.user.yml
storage/*
!storage/.gitkeep
logs/*
!logs/.gitkeep

# ── IDE / editor ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing / coverage ────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Misc ───────────────────────────────────────────────────────────────
*.log
*.bak
*.tmp
